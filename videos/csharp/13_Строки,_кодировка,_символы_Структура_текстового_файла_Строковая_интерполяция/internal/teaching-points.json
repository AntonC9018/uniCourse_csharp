      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-016",
      "startMilliseconds": 173920,
      "endMilliseconds": 186750,
      "kind": "fact",
      "text": "The conversion also works in reverse: a stored number such as 72 can be converted back into the corresponding character.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 173920,
          "endMilliseconds": 186750
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#converting-a-number-back-to-a-character"
      }
    },
    {
      "id": "TP-017",
      "startMilliseconds": 186750,
      "endMilliseconds": 204550,
      "kind": "reason",
      "text": "An int can hold values a char cannot, so its memory cell is larger, and shrinking the number back into a char requires an explicit cast.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 186750,
          "endMilliseconds": 204550
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#converting-a-number-back-to-a-character"
      }
    },
    {
      "id": "TP-018",
      "startMilliseconds": 204550,
      "endMilliseconds": 223110,
      "kind": "explanation",
      "text": "A numeric cast behaves unlike a cast between reference types: it simply cuts off the information that does not fit the smaller cell, which is called truncation.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 204550,
          "endMilliseconds": 223110
        }
      ],
      "englishCoverage": {
        "status": "covered",
