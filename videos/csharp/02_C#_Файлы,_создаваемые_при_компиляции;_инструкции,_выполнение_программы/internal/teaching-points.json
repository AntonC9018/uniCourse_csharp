  "teachingPoints": [
    {
      "id": "TP-001",
      "startMilliseconds": 2480,
      "endMilliseconds": 10510,
      "kind": "fact",
      "text": "The .NET compiler picks up all .cs files in the project automatically, so the file list does not have to be declared anywhere.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 2480,
          "endMilliseconds": 10510
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#how-the-compiler-finds-source-files"
      }
    },
    {
      "id": "TP-002",
      "startMilliseconds": 10510,
      "endMilliseconds": 29690,
      "kind": "explanation",
      "text": "The project starts as a single .cs source file whose lines are the program's top-level statements, which the compiler transforms into a class and an entry method.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 10510,
          "endMilliseconds": 29690
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#top-level-statements-what-the-project-starts-as"
      }
    },
    {
      "id": "TP-003",
      "startMilliseconds": 29690,
      "endMilliseconds": 45510,
      "kind": "reason",
      "text": "Because all .cs files are picked up automatically, you can put them in the root folder or in nested folders and both will compile and run.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 29690,
          "endMilliseconds": 45510
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#how-the-compiler-finds-source-files"
      }
    },
    {
      "id": "TP-004",
      "startMilliseconds": 45510,
      "endMilliseconds": 54000,
      "kind": "fact",
      "text": "The bin folder is created automatically and stores the compiled output (DLL or executable) of the project.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 45510,
          "endMilliseconds": 54000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#bin-the-folder-of-compiled-output"
      }
    },
    {
      "id": "TP-005",
      "startMilliseconds": 54000,
      "endMilliseconds": 67800,
      "kind": "fact",
      "text": "The obj folder is created automatically and caches the intermediate compilation data produced during builds.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 54000,
          "endMilliseconds": 67800
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#obj-the-build-cache-folder"
      }
    },
    {
      "id": "TP-006",
      "startMilliseconds": 67800,
      "endMilliseconds": 74000,
      "kind": "explanation",
      "text": "dotnet run performs both compilation and launch, producing a file you can execute yourself.",
