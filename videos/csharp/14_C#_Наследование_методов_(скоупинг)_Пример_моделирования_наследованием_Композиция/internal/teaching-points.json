  "teachingPoints": [
    {
      "id": "TP-001",
      "startMilliseconds": 160,
      "endMilliseconds": 14630,
      "kind": "explanation",
      "text": "Inheritance determines scoping: a derived object exposes the fields and methods of its base class under the same names.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 160,
          "endMilliseconds": 14630
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-002",
      "startMilliseconds": 14630,
      "endMilliseconds": 28160,
      "kind": "fact",
      "text": "A Derived instance can read the field it inherits from Base, which is why inheritance lets you treat a derived object as having base-class state.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 14630,
          "endMilliseconds": 28160
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-003",
      "startMilliseconds": 28360,
      "endMilliseconds": 43670,
      "kind": "fact",
      "text": "An instance method declared in either Base or Derived is callable as d.Method or Base.Method, so the call target does not depend on where the method was declared.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 28360,
          "endMilliseconds": 43670
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-004",
      "startMilliseconds": 48300,
      "endMilliseconds": 57350,
      "kind": "explanation",
      "text": "Through inheritance the same method is reachable both through the derived class and through the base class, which is the core idea behind inherited scoping.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 48300,
          "endMilliseconds": 57350
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-005",
      "startMilliseconds": 57350,
      "endMilliseconds": 64170,
      "kind": "fact",
      "text": "Static methods follow the same inheritance visibility rule as instance methods and can be declared in the base class.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 57350,
          "endMilliseconds": 64170
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-006",
      "startMilliseconds": 64170,
      "endMilliseconds": 79720,
      "kind": "reason",
      "text": "Static methods cannot be called through an object with d.Method because there is no instance; the class name must be used instead.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 64170,
          "endMilliseconds": 79720
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-007",
      "startMilliseconds": 71920,
      "endMilliseconds": 79720,
      "kind": "reason",
      "text": "A static base-class method must be invoked through a class name, and that name may be either Derived or Base because the static method is inherited by Derived.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 71920,
          "endMilliseconds": 79720
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-008",
      "startMilliseconds": 79720,
      "endMilliseconds": 93450,
      "kind": "explanation",
      "text": "When the compiler does not find a method of that name in Derived, it keeps searching the base classes and finds the Base implementation, which is how inherited members stay callable.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 79720,
          "endMilliseconds": 93450
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-009",
      "startMilliseconds": 93700,
      "endMilliseconds": 109900,
      "kind": "reason",
      "text": "This base-class lookup happens statically at compile time, not at runtime, so the compiler already knows which method d.BaseMethod refers to and no run-time search occurs.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 93700,
          "endMilliseconds": 109900
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#inherited-fields-and-methods"
      }
    },
    {
      "id": "TP-010",
      "startMilliseconds": 111800,
      "endMilliseconds": 135680,
      "kind": "fact",
      "text": "If Base already declares a method with the same name as one in Derived, you must add the new modifier in Derived whether or not the methods are static, otherwise the compiler reports an error.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 111800,
          "endMilliseconds": 135680
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#hiding-and-the-static-type"
      }
    },
    {
      "id": "TP-011",
      "startMilliseconds": 135680,
      "endMilliseconds": 155680,
      "kind": "explanation",
      "text": "The new modifier tells the compiler that you know the base class already defines that method and you deliberately define a same-named method in the derived class.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 135680,
          "endMilliseconds": 155680
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#hiding-and-the-static-type"
      }
    },
    {
      "id": "TP-012",
      "startMilliseconds": 146519,
      "endMilliseconds": 155680,
      "kind": "explanation",
      "text": "For a call like d.Method the compiler first looks at the static type of d, which is Derived, and resolves the call in the Derived class.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 146519,
          "endMilliseconds": 155680
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#hiding-and-the-static-type"
      }
    },
    {
      "id": "TP-013",
      "startMilliseconds": 155680,
      "endMilliseconds": 169500,
      "kind": "explanation",
      "text": "If the name is not found in Derived the compiler continues into the base classes, which is why an inherited method remains callable through the derived reference.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 155680,
          "endMilliseconds": 169500
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#hiding-and-the-static-type"
      }
    },
    {
      "id": "TP-014",
      "startMilliseconds": 169500,
      "endMilliseconds": 183000,
      "kind": "reason",
      "text": "For a call like b.Method the static type of the variable is Base, so the compiler resolves the name inside Base and calls the base implementation even though the object at run time may be a Derived.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 169500,
          "endMilliseconds": 183000
        }
