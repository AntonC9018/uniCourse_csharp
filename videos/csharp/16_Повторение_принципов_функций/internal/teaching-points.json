    },
    {
      "id": "TP-003",
      "startMilliseconds": 19990,
      "endMilliseconds": 22560,
      "kind": "scope_boundary",
      "text": "The static keyword is deliberately postponed, so it is out of scope for this syntax review.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 19990,
          "endMilliseconds": 22560
        }
      ],
      "englishCoverage": {
        "status": "covered",
