    },
    {
      "id": "TP-002",
      "startMilliseconds": 14120,
      "endMilliseconds": 19990,
      "kind": "fact",
      "text": "A function declaration starts with the return type, and this function returns void because it only runs commands.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 14120,
          "endMilliseconds": 19990
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#group-two-instructions-under-one-name"
