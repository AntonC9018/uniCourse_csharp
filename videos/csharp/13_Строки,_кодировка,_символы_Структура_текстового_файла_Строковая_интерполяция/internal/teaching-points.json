  "teachingPoints": [
    {
      "id": "TP-001",
      "startMilliseconds": 80,
      "endMilliseconds": 18600,
      "kind": "fact",
      "text": "A string in C# is an object that represents a sequence of characters, which is why it behaves unlike a primitive value.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 80,
          "endMilliseconds": 18600
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#strings-and-immutable-objects"
      }
    },
    {
      "id": "TP-002",
      "startMilliseconds": 18600,
      "endMilliseconds": 20320,
      "kind": "explanation",
      "text": "The only thing a string can contain is characters, so any string content must ultimately be reduced to characters.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 18600,
          "endMilliseconds": 20320
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#strings-and-immutable-objects"
      }
    },
    {
      "id": "TP-003",
      "startMilliseconds": 20320,
      "endMilliseconds": 23920,
      "kind": "fact",
      "text": "A string can also be defined as an array of characters, which gives a second useful mental model for it.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 20320,
          "endMilliseconds": 23920
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#strings-and-immutable-objects"
      }
    },
    {
      "id": "TP-004",
      "startMilliseconds": 23920,
      "endMilliseconds": 32230,
      "kind": "explanation",
      "text": "The difference between a string and a character array is mutability: characters taken from a string cannot be modified, while characters in an array can be changed.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 23920,
          "endMilliseconds": 32230
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#strings-and-immutable-objects"
      }
    },
    {
      "id": "TP-005",
      "startMilliseconds": 32230,
      "endMilliseconds": 39000,
      "kind": "fact",
      "text": "A string is an immutable type allocated in dynamic memory, so an existing string instance can never be altered in place.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 32230,
          "endMilliseconds": 39000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#strings-and-immutable-objects"
      }
    },
    {
      "id": "TP-006",
      "startMilliseconds": 39000,
      "endMilliseconds": 48830,
      "kind": "explanation",
      "text": "Because strings are immutable, the only change a program can make is overwriting the variable's reference with a different string, which changes the variable's memory, not the string object.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 39000,
          "endMilliseconds": 48830
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#strings-and-immutable-objects"
      }
    },
    {
      "id": "TP-007",
      "startMilliseconds": 55790,
      "endMilliseconds": 77600,
      "kind": "fact",
      "text": "A computer never stores a character's graphic shape in memory, it stores a number, and every character therefore has a number associated with it.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 55790,
          "endMilliseconds": 77600
        },
        {
          "type": "transcript_range",
          "startMilliseconds": 68360,
          "endMilliseconds": 77600
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-008",
      "startMilliseconds": 77600,
      "endMilliseconds": 87500,
      "kind": "fact",
      "text": "C# has the special char type, which is a value type rather than a reference type and can hold a single character.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 77600,
          "endMilliseconds": 87500
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-009",
      "startMilliseconds": 87500,
      "endMilliseconds": 95500,
      "kind": "fact",
      "text": "A single character can be taken from a string with indexer syntax or obtained directly with the character literal syntax.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 87500,
          "endMilliseconds": 95500
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-010",
      "startMilliseconds": 95500,
      "endMilliseconds": 102400,
      "kind": "fact",
      "text": "In C# strings are always written in double quotes while characters are written in single quotes, so the quote style tells the compiler which type is meant.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 95500,
          "endMilliseconds": 102400
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-011",
      "startMilliseconds": 102400,
      "endMilliseconds": 109000,
      "kind": "explanation",
      "text": "The compiler converts character literals into their numeric values, so a character can in principle be treated as a plain number.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 102400,
          "endMilliseconds": 109000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-012",
      "startMilliseconds": 109000,
      "endMilliseconds": 115000,
      "kind": "fact",
      "text": "Instead of storing a character in a char variable you may store the same symbol in an int variable, which the compiler accepts.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 109000,
          "endMilliseconds": 115000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-013",
      "startMilliseconds": 115000,
      "endMilliseconds": 127000,
      "kind": "explanation",
      "text": "Printing a char variable shows the symbol itself, whereas seeing the character's numeric code requires storing it as a number first.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 115000,
          "endMilliseconds": 127000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-014",
      "startMilliseconds": 127000,
      "endMilliseconds": 140000,
      "kind": "fact",
      "text": "Converting a char value to an int with a cast keeps the very same number in memory, it only changes how the value is typed.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 127000,
          "endMilliseconds": 140000
        }
      ],
      "englishCoverage": {
        "status": "covered",
        "anchor": "#characters-literals-and-numeric-output"
      }
    },
    {
      "id": "TP-015",
      "startMilliseconds": 140000,
      "endMilliseconds": 163160,
      "kind": "explanation",
      "text": "Console.WriteLine prints a char as a symbol and an int holding the same number as a number, because it relies on the static type of the expression.",
      "evidence": [
        {
          "type": "transcript_range",
          "startMilliseconds": 140000,
          "endMilliseconds": 157040
        },
        {
          "type": "transcript_range",
