  "teachingPoints": [
    {
      "id": "TP-001",
      "startMilliseconds": 280,
      "endMilliseconds": 14000,
      "kind": "reason",
      "text": "Functions let you group several instructions under one name, which is why they exist at all.",
      "evidence": [
